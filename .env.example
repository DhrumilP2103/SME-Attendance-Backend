NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Use your existing MongoDB on port 27017; transactions require a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/sme_attendance
# Required in production: independent 64-character hexadecimal encryption keys.
ACCESS_TOKEN_ENCRYPTION_KEY=
OUTBOX_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Explicit opt-in only. Never available in production.
DEMO_MODE=false
