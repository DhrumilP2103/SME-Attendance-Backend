# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3000

# ── Database ────────────────────────────────────────────────────
# Use your existing MongoDB on port 27017; transactions require a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/sme_attendance

# ── Demo mode (production must be false) ────────────────────────
DEMO_MODE=false

# ── Encryption keys: exactly 64 hex characters each ─────────────
# Leave blank in development: keys are auto-generated into .local/keys.json
# Generate for production:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_ENCRYPTION_KEY=
OUTBOX_ENCRYPTION_KEY=

# ── SMTP ────────────────────────────────────────────────────────
# Gmail example: host smtp.gmail.com, port 587, secure false,
# password = 16-character Google App Password (needs 2-Step Verification on).
# Port 465 uses SMTP_SECURE=true; port 587 uses SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM="SME Attendance <your-address@gmail.com>"
